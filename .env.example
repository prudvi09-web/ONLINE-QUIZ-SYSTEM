# ===================================================================
# Database Configuration for Aiven MySQL (or any cloud database)
# ===================================================================
# For Render Deployment:
# Add these key-value pairs in your Render Dashboard -> "Environment" tab
#
# For Local Testing with Aiven:
# Set these system environment variables before running the backend
#
# Aiven MySQL JDBC Connection URL format:
# jdbc:mysql://<HOST>:<PORT>/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true

# Aiven MySQL Username (default is avnadmin)
SPRING_DATASOURCE_USERNAME=avnadmin

# Aiven MySQL Password
SPRING_DATASOURCE_PASSWORD=your_aiven_password_here

# Hibernate DDL Auto (update will automatically create and update tables)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Server Port (Render sets this automatically, default is 8080)
PORT=8080

# JWT Secret (Pre-configured default or custom 256-bit key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
